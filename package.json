{
  "name": "@mbanda1/date-picker",
  "version": "1.0.0",
  "description": "Headless-first, accessible React date and date-range pickers",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbanda1/date-picker.git"
  },
  "author": "mbanda1",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.mts",
        "default": "./dist/headless.mjs"
      },
      "require": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example:dev": "pnpm build && pnpm --filter date-picker-example-nextjs dev",
    "example:smoke": "pnpm build && pnpm --filter date-picker-example-nextjs build && pnpm --filter date-picker-example-nextjs smoke"
  },
  "keywords": [
    "react",
    "nextjs",
    "date-picker",
    "date-range-picker",
    "datepicker",
    "calendar",
    "headless",
    "accessible"
  ],
  "packageManager": "pnpm@10.15.1",
  "peerDependencies": {
    "date-fns": "^3.0.0 || ^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "date-fns": "^4.4.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9"
  }
}
